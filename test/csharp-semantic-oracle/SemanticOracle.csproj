<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool (Part C, C0a-2): the semantic caller oracle. Built into the scratchpad
       (csharp-tools/oracle-semantic/), never inside the repository. It compiles the syntax
       oracle's Program.cs too, so callers and targets are keyed by the same function
       (Oracle.MembersOf). The cache key hashes this file, Program.cs and the syntax oracle's
       Program.cs (run.sh). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not invariant: source generators run in this process, and [GeneratedRegex(…, "en-US")]
         needs the culture (with invariant globalization the generator fails: CS8795). -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <AssemblyName>SemanticOracle</AssemblyName>
    <StartupObject>SemanticOracle</StartupObject>
    <NoWarn>CS7022</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../csharp-syntax-oracle/Program.cs" Link="SyntaxOracle.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.12.0" />
  </ItemGroup>
</Project>
