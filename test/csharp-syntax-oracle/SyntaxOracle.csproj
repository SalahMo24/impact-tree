<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool for test/lsp-harness/csharp-verify.js (Part C, C0a-1). Built into the scratchpad
       (csharp-tools/oracle-syntax/), never inside the repository. The Roslyn version below is
       part of the oracle's cache key (the key hashes this file and Program.cs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SyntaxOracle</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
</Project>
