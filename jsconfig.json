{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "scripts/drive.js",
    "scripts/setup.js",
    "scripts/check.js",
    "scripts/check-baseline.js",
    "scripts/pr-link.js",
    "scripts/local-notes.js",
    "scripts/check-public.js"
  ]
}
