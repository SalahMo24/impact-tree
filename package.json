          "command": "impactTree.feedback.showDrafts",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.sendFeedbackTo",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.feedback.openRoundItem",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "impactTree.review.suggestChange",
          "group": "impactTree@1",
          "when": "impactTree.canSuggestChange"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "impactTree.review.startReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.commentNow",
          "group": "inline@2",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.addReviewComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.reply",
          "group": "inline@1",
          "when": "commentController == impactTree.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/ && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.replyToReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/ && impactTree.reviewPending"
        },
        {
          "command": "impactTree.feedback.add",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && commentThreadIsEmpty"
        },
        {
          "command": "impactTree.feedback.cancel",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "impactTree.review.resolve",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcanResolve\\b/"
        },
        {
          "command": "impactTree.review.unresolve",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcanUnresolve\\b/"
        },
        {
          "command": "impactTree.review.removeCallerContext",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcallerContext\\b/"
        },
        {
          "command": "impactTree.review.suggestChange",
          "group": "inline@2",
          "when": "commentController == impactTree.review && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "impactTree.review.editComment",
          "group": "inline@0",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.deletePendingComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment =~ /\\bpendingMine\\b/"
        },
        {
          "command": "impactTree.review.applySuggestion",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment =~ /\\bhasSuggestion\\b/"
        },
        {
          "command": "impactTree.feedback.edit",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        },
        {
          "command": "impactTree.feedback.delete",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        }
      ],
      "view/item/context": [
        {
          "command": "impactTree.showCallers",
          "when": "view == impactTree.changes && viewItem == finding",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.showCallers",
          "when": "view == impactTree.changes && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "impactTree.retryViewedSync",
          "when": "view == impactTree.changes && viewItem =~ /ViewedFailed$/",
          "group": "inline"
        },
        {
          "command": "impactTree.feedback.edit",
          "when": "view == impactTree.changes && viewItem == feedbackDraft",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.delete",
          "when": "view == impactTree.changes && viewItem == feedbackDraft",
          "group": "inline@2"
        },
        {
          "command": "impactTree.feedback.edit",
          "when": "view == impactTree.changes && viewItem == feedbackDraft",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.feedback.delete",
          "when": "view == impactTree.changes && viewItem == feedbackDraft",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "view == impactTree.changes && viewItem == feedbackGroup",
          "group": "inline@1"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "view == impactTree.changes && viewItem =~ /^feedback(Group|Draft)$/",
          "group": "send@1"
        },
        {
          "command": "impactTree.sendFeedbackTo",
          "when": "view == impactTree.changes && viewItem =~ /^feedback(Group|Draft)$/",
          "group": "send@2"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "view == impactTree.changes && viewItem == feedbackRoundItem",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "view == impactTree.changes && viewItem == feedbackRoundItem",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "view == impactTree.changes && viewItem == feedbackRound",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "view == impactTree.changes && viewItem == feedbackRound",
          "group": "navigation@1"
        }
      ],
      "comments/comment/context": [
        {
          "command": "impactTree.review.saveEdit",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.cancelEdit",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.startReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment == suggestionDraft && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.commentNow",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment == suggestionDraft && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.addReviewComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment == suggestionDraft && impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.cancelEdit",
          "group": "inline@3",
          "when": "commentController == impactTree.review && comment == suggestionDraft"
        },
        {
          "command": "impactTree.feedback.saveEdit",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        },
        {
          "command": "impactTree.feedback.cancelEdit",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        }
      ]
    },
    "keybindings": [
      {
        "command": "impactTree.nextUnreviewed",
        "key": "alt+n",
        "when": "impactTree.hasReview"
      },
      {
        "command": "impactTree.previousUnreviewed",
        "key": "shift+alt+n",
        "when": "impactTree.hasReview"
      },
      {
        "command": "impactTree.showCallers",
        "key": "shift+alt+c",
        "when": "editorTextFocus && impactTree.hasReview"
      }
    ],
    "configuration": {
      "title": "Impact Tree",
      "properties": {
        "impactTree.openPullRequestTab": {
          "type": "boolean",
          "default": true,
          "description": "Open the Pull Request tab (description, checks, reviewers, labels, merge and review submit) when you preview or check out a pull request from the list."
        },
        "impactTree.githubRemote": {
          "type": "string",
          "default": "",
          "description": "The git remote of the GitHub repository whose pull requests are reviewed. Empty: `upstream` if it points at GitHub, else `origin`, else the only GitHub remote."
        },
        "impactTree.mode": {
          "type": "string",
          "enum": [
            "pr",
            "branch",
            "working",
            "checkpoint"
          ],
          "default": "pr",
          "description": "What to review: pr = Branch vs base (the commits a pull request would hold); branch = Branch + uncommitted; working = Uncommitted (agent), your edits since the last commit; checkpoint = Since checkpoint, everything since the commit you recorded."
        },
        "impactTree.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Base branch. Always resolved to <remote>/<branch>, where the remote is the GitHub remote (impactTree.githubRemote), else origin; an out-of-date local ref silently inflates the diff. Write <remote>/<branch>, for example origin/main, to read it from another remote."
        },
        "impactTree.fetchBase": {
          "type": "boolean",
          "default": true,
          "description": "git fetch the base before resolving it"
        },
        "impactTree.reachDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "How many caller levels the test-reachability walk follows upward from a changed symbol, 1 to 6. A test further up than this is not looked for, so \"no test reaches\" means no test within this many levels. A value outside the range is replaced with 2 (or 6 when too large) and a warning is shown."
        },
        "impactTree.analyseOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Analyse as soon as the window opens"
        },
        "impactTree.alwaysDiffCallers": {
          "type": "boolean",
          "default": false,
          "description": "Open every caller as a diff against the base, even when the file is identical to base (which shows two panes of the same content). Default: diff only when the file actually differs."
        },
        "impactTree.concurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "description": "How many symbols to resolve callers for in parallel, from 1 to 32. A value above 32 is capped at 32; a value that is not a number of at least 1 is replaced by the default, 8. Either correction is reported as an analysis warning."
        },
        "impactTree.iconMode": {
          "type": "string",
          "enum": [
            "file",
            "symbol"
          ],
          "default": "symbol",
          "enumDescriptions": [
            "File-type glyph from your icon theme (matches the Explorer and other review extensions)",
            "Symbol-kind icon: method / function / constructor (matches Outline)"
          ],
          "description": "Which icon change rows use. File rows always show the file-type glyph."
        },
        "impactTree.rowDetail": {
          "type": "string",
          "enum": [
            "hover",
            "inline"
          ],
          "default": "hover",
          "enumDescriptions": [
            "A change row shows its verdict glyph only; the verdict in words and the change kinds are in the hover tooltip",
            "A change row also shows the verdict in words and the change kinds (denser, truncates in narrow sidebars)"
          ],
          "description": "Where a change row's verdict and change kinds are shown."
        },
        "impactTree.fileListLayout": {
          "type": "string",
          "enum": [
            "flat",
            "tree"
          ],
          "default": "flat",
          "enumDescriptions": [
            "One row per changed file, worst first",
            "Changed files in their folders, as in the GitHub Pull Requests extension; folders and files are still ordered worst first at every level, and a folder is ranked by its worst file"
          ],
          "description": "How the Changes view lays out the changed files. Also toggled from the view's title bar (View as tree / View as list)."
        },
        "impactTree.prewarm": {
          "type": "boolean",
          "default": true,
          "description": "After the window opens, quietly ask the language server to index the changed files so the first analysis is fast. The index is built either way; this just pays for it before you ask."
        },
        "impactTree.filterInheritedOverReports": {
          "type": "boolean",
          "default": true,
          "description": "Drop callers the TypeScript call hierarchy attributes to an override but which actually dispatch on a sibling subclass. Turn off to see the unfiltered call-hierarchy result."
        },
        "impactTree.tierA.maxFiles": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "maximum": 3000,
          "description": "Maximum files to fetch for a no-checkout PR preview, 1 to 3000 (the most the GitHub client lists). Each file costs two GitHub API requests (head and base). A value outside the range is replaced with 300 (or 3000 when too large) and a warning is shown."
        },
        "impactTree.agent": {
          "type": "string",
          "enum": [
            "ask",
            "claude",
            "codex",
            "chat",
            "clipboard",
            "save"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask each time; the answer is remembered here",
            "Claude Code: run claude with the prompt in a terminal",
            "Codex: run codex with the prompt in a terminal",
            "Fill the editor's chat (VS Code Copilot Chat, Cursor) with the prompt; you press Enter",
            "Copy the prompt to the clipboard",
            "Only save the feedback file"
          ],
          "description": "Where Send feedback hands a feedback round. \"Send feedback to…\" always asks."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalahMo24/impact-tree.git"
  },
  "bugs": {
    "url": "https://github.com/SalahMo24/impact-tree/issues"
  },
  "keywords": [
    "pull request",
    "code review",
    "pr review",
    "diff",
    "call hierarchy",
    "call graph",
    "impact analysis",
    "blast radius",
    "dependency graph",
    "refactoring",
    "typescript",
    "github"
  ],
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
