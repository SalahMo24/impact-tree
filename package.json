  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactTree",
          "title": "Impact Tree",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "impactTree": [
        {
          "id": "impactTree.sources",
          "name": "Review",
          "contextualTitle": "Impact Tree"
        },
        {
          "id": "impactTree.changes",
          "name": "Changes",
          "contextualTitle": "Impact Tree"
        },
        {
          "type": "webview",
          "id": "impactTree.details",
          "name": "Details",
          "contextualTitle": "Impact Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "impactTree.changes",
        "contents": "No folder is open, so there is nothing to review.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "impactTree.state == noFolder"
      },
      {
        "view": "impactTree.changes",
        "contents": "This folder is not a git repository. Impact Tree reviews the difference between git commits.\n[Initialize Repository](command:git.init)\nAlready a repository? [Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == noGit"
      },
      {
        "view": "impactTree.changes",
        "contents": "Review a change by what it affects, not just what it touches. Pick where the change is:\n[Review my branch](command:impactTree.analyseMode?%5B%22pr%22%5D)\nThe commits on this branch compared with the base branch: what a pull request will contain.\n[Review uncommitted (agent) changes](command:impactTree.analyseMode?%5B%22working%22%5D)\nWhat you or a coding agent changed since the last commit.\n[Open a pull request](command:impactTree.sources.focus)\nPreview or check out an open pull request from GitHub.",
        "when": "impactTree.state == idle"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Branch vs base mode.\nThis branch has no commits beyond the base branch, so a pull request from it would be empty.\n[Switch mode](command:impactTree.selectMode)\n[Change the base branch](command:workbench.action.openSettings?%5B%22impactTree.baseBranch%22%5D)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == pr"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Branch + uncommitted mode.\nThere are no commits beyond the base branch and no uncommitted edits.\n[Switch mode](command:impactTree.selectMode)\n[Change the base branch](command:workbench.action.openSettings?%5B%22impactTree.baseBranch%22%5D)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == branch"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Uncommitted (agent) mode.\nThere are no uncommitted edits. Run this after you or a coding agent change files.\n[Switch mode](command:impactTree.selectMode)\n[Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == working"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Since checkpoint mode.\nNothing has changed since the checkpoint you recorded.\n[Switch mode](command:impactTree.selectMode)\n[Set checkpoint now](command:impactTree.setCheckpoint)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == checkpoint"
      },
      {
        "view": "impactTree.changes",
        "contents": "Impact Tree could not load TypeScript for the changed files, so none of them was analysed. This is not a result of \"no impact\".\nInstall the project's dependencies (for example npm install), then refresh.\n[Refresh](command:impactTree.refresh)\n[Show log](command:impactTree.showLog)",
        "when": "impactTree.state == noTypeScript"
      },
      {
        "view": "impactTree.sources",
        "contents": "No folder is open. Open a repository to review its changes and pull requests.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "impactTree.state == noFolder"
      },
      {
        "view": "impactTree.sources",
        "contents": "This folder is not a git repository, so there is nothing to compare.\n[Initialize Repository](command:git.init)\nAlready a repository? [Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == noGit"
      }
    ],
