        },
        {
          "command": "impactTree.filterUnreviewed",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.filterUnreviewedOn",
          "when": "false"
        },
        {
          "command": "impactTree.filterThreads",
          "when": "impactTree.hasReviewThreads"
        },
        {
          "command": "impactTree.filterThreadsOn",
