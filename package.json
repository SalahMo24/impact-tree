    "menus": {
      "view/title": [
        {
          "command": "impactTree.refresh",
          "when": "view == impactTree.changes",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.filterAttention",
          "when": "view == impactTree.changes && impactTree.filter != attention",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.filterAttentionOn",
          "when": "view == impactTree.changes && impactTree.filter == attention",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.filterUnreviewed",
          "when": "view == impactTree.changes && impactTree.filter != unreviewed",
          "group": "navigation@3"
        },
        {
          "command": "impactTree.filterUnreviewedOn",
          "when": "view == impactTree.changes && impactTree.filter == unreviewed",
          "group": "navigation@3"
        },
        {
          "command": "impactTree.filterThreads",
          "when": "view == impactTree.changes && impactTree.filter != threads && impactTree.hasReviewThreads",
          "group": "navigation@3"
        },
        {
          "command": "impactTree.filterThreadsOn",
          "when": "view == impactTree.changes && impactTree.filter == threads",
          "group": "navigation@3"
        },
        {
          "command": "impactTree.previousUnreviewed",
          "when": "view == impactTree.changes",
          "group": "navigation@4"
        },
        {
          "command": "impactTree.nextUnreviewed",
          "when": "view == impactTree.changes",
          "group": "navigation@5"
        },
        {
          "command": "impactTree.viewAsTree",
          "when": "view == impactTree.changes && impactTree.fileListLayout != tree",
          "group": "navigation@8"
        },
        {
          "command": "impactTree.viewAsList",
          "when": "view == impactTree.changes && impactTree.fileListLayout == tree",
          "group": "navigation@8"
        },
        {
          "command": "impactTree.selectMode",
          "when": "view == impactTree.changes",
          "group": "1_mode@1"
        },
        {
          "command": "impactTree.setCheckpoint",
          "when": "view == impactTree.changes",
          "group": "1_mode@2"
        },
        {
          "command": "impactTree.showLog",
