{
  "name": "impact-tree",
  "publisher": "SalahMo24",
  "displayName": "Impact Tree",
  "icon": "images/icon.png",
  "description": "Review a diff as an inverted call graph — see what each change affects and which callers weren't updated.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "analyze": "node --max-old-space-size=8192 src/cli.js",
    "test": "node test/loading.test.js && node test/scope.test.js && node test/local-symbols.test.js && node test/local-diff.test.js && node test/local-programs.test.js && node test/syntax-regressions.test.js && node test/remote-regressions.test.js && node test/editor-regressions.test.js && node test/review-identity-regressions.test.js && node test/engine-regressions.test.js && node test/cqrs-cache.test.js && node test/call-site-classifier.test.js && node test/caller-evidence.test.js && node test/extension-commands.test.js && node test/cancellation.test.js && node test/request-boundary.test.js && node test/session-lifecycle.test.js && node test/review-key.test.js && node test/load-typescript.test.js && node test/base-ref.test.js && node test/sources.test.js && node test/pr-groups.test.js && node test/tier-a-view.test.js && node test/tree-grouping.test.js && node test/tree-characterization.test.js && node test/tree-grouping-rules.test.js && node test/tree-row-models.test.js && node test/empty-states-and-limits.test.js && node test/path-tree.test.js && node test/review-tree-model.test.js && node test/feedback-file.test.js && node test/vocabulary.test.js && node test/review-tree-view.test.js && node test/tree-cleanup.test.js && node test/review-updates.test.js && node test/review-navigation.test.js && node test/detail-panel-html.test.js && node test/detail-panel.test.js && node test/review-lens.test.js && node test/pr-review-data.test.js && node test/pr-review-store.test.js && node test/pr-overview-html.test.js && node test/pr-overview-panel.test.js && node test/diff-lines.test.js && node test/review-comments.test.js && node test/review-threads.test.js && node test/review-threads-details.test.js && node test/viewed-sync.test.js && node test/outside-functions.test.js && node test/test-reach.test.js && node test/test-reach-view.test.js && node test/syntactic-index.test.js && node test/inheritance.test.js && node test/tier-a.test.js && node test/preview-retention.test.js && node --max-old-space-size=8192 test/languages.test.js && node --max-old-space-size=8192 test/textpos.test.js && node --max-old-space-size=8192 test/callsites.test.js && node --max-old-space-size=8192 test/run-fixtures.js && node --max-old-space-size=8192 test/tree-smoke.js && node test/storage-cleanup.test.js && node test/agent-handoff.test.js && node test/snapshot-store.test.js",
    "record": "node --max-old-space-size=8192 test/record-fixture.js",
    "test:snapshots": "node --max-old-space-size=8192 test/t3-pr-snapshots.js",
    "test:fixtures": "node --max-old-space-size=8192 test/run-fixtures.js",
    "test:tree": "node --max-old-space-size=8192 test/tree-smoke.js",
    "test:textpos": "node test/textpos.test.js",
    "test:callsites": "node --max-old-space-size=8192 test/callsites.test.js",
    "test:languages": "node --max-old-space-size=8192 test/languages.test.js",
    "test:scope": "node test/scope.test.js",
    "test:sources": "node test/sources.test.js",
    "test:syntactic": "node test/syntactic-index.test.js",
    "test:inheritance": "node test/inheritance.test.js",
    "test:tier-a": "node test/tier-a.test.js",
    "test:tier-a-view": "node test/tier-a-view.test.js",
    "test:loadts": "node test/load-typescript.test.js",
    "test:baseref": "node test/base-ref.test.js",
    "test:smoke": "node --test test/loading.test.js test/review-findings-smoke.test.js test/review-preview-smoke.test.js",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactTree",
          "title": "Impact Tree",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "impactTree": [
        {
          "id": "impactTree.sources",
          "name": "Review",
          "contextualTitle": "Impact Tree"
        },
        {
          "id": "impactTree.changes",
          "name": "Changes",
          "contextualTitle": "Impact Tree"
        },
        {
          "type": "webview",
          "id": "impactTree.details",
          "name": "Details",
          "contextualTitle": "Impact Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "impactTree.changes",
        "contents": "No folder is open, so there is nothing to review.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "impactTree.state == noFolder"
      },
      {
        "view": "impactTree.changes",
        "contents": "This folder is not a git repository. Impact Tree reviews the difference between git commits.\n[Initialize Repository](command:git.init)\nAlready a repository? [Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == noGit"
      },
      {
        "view": "impactTree.changes",
        "contents": "Review a change by what it affects, not just what it touches. Pick where the change is:\n[Review my branch](command:impactTree.analyseMode?%5B%22pr%22%5D)\nThe commits on this branch compared with the base branch: what a pull request will contain.\n[Review uncommitted (agent) changes](command:impactTree.analyseMode?%5B%22working%22%5D)\nWhat you or a coding agent changed since the last commit.\n[Open a pull request](command:impactTree.sources.focus)\nPreview or check out an open pull request from GitHub.",
        "when": "impactTree.state == idle"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Branch vs base mode.\nThis branch has no commits beyond the base branch, so a pull request from it would be empty.\n[Switch mode](command:impactTree.selectMode)\n[Change the base branch](command:workbench.action.openSettings?%5B%22impactTree.baseBranch%22%5D)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == pr"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Branch + uncommitted mode.\nThere are no commits beyond the base branch and no uncommitted edits.\n[Switch mode](command:impactTree.selectMode)\n[Change the base branch](command:workbench.action.openSettings?%5B%22impactTree.baseBranch%22%5D)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == branch"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Uncommitted (agent) mode.\nThere are no uncommitted edits. Run this after you or a coding agent change files.\n[Switch mode](command:impactTree.selectMode)\n[Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == working"
      },
      {
        "view": "impactTree.changes",
        "contents": "Nothing changed in Since checkpoint mode.\nNothing has changed since the checkpoint you recorded.\n[Switch mode](command:impactTree.selectMode)\n[Set checkpoint now](command:impactTree.setCheckpoint)",
        "when": "impactTree.state == nothingChanged && impactTree.resultMode == checkpoint"
      },
      {
        "view": "impactTree.changes",
        "contents": "Impact Tree could not load TypeScript for the changed files, so none of them was analysed. This is not a result of \"no impact\".\nInstall the project's dependencies (for example npm install), then refresh.\n[Refresh](command:impactTree.refresh)\n[Show log](command:impactTree.showLog)",
        "when": "impactTree.state == noTypeScript"
      },
      {
        "view": "impactTree.sources",
        "contents": "No folder is open. Open a repository to review its changes and pull requests.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "impactTree.state == noFolder"
      },
      {
        "view": "impactTree.sources",
        "contents": "This folder is not a git repository, so there is nothing to compare.\n[Initialize Repository](command:git.init)\nAlready a repository? [Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == noGit"
      }
    ],
    "commands": [
      {
        "command": "impactTree.retryViewedSync",
        "title": "Impact Tree: Retry Viewed on GitHub",
        "icon": "$(sync)"
      },
      {
        "command": "impactTree.refresh",
        "title": "Impact Tree: Refresh",
        "icon": "$(refresh)"
      },
      {
