{
  "name": "impact-tree",
  "publisher": "SalahMo24",
  "displayName": "Impact Tree",
  "icon": "images/icon.png",
  "description": "Review a diff as an inverted call graph — see what each change affects and which callers weren't updated. TypeScript, JavaScript, Go and Python.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "analyze": "node --max-old-space-size=8192 src/cli.js",
    "test": "node test/run.js",
    "test:quick": "node test/run.js --tier quick",
    "test:serial": "node test/run.js --serial",
    "record": "node --max-old-space-size=8192 test/record-fixture.js",
    "test:snapshots": "node --max-old-space-size=8192 test/t3-pr-snapshots.js",
    "test:fixtures": "node --max-old-space-size=8192 test/run-fixtures.js",
    "test:tree": "node --max-old-space-size=8192 test/tree-smoke.js",
    "test:textpos": "node test/textpos.test.js",
    "test:callsites": "node --max-old-space-size=8192 test/callsites.test.js",
    "test:languages": "node --max-old-space-size=8192 test/languages.test.js",
    "test:sources": "node test/sources.test.js",
    "test:syntactic": "node test/syntactic-index.test.js",
    "test:inheritance": "node test/inheritance.test.js",
    "test:tier-a": "node test/tier-a.test.js",
    "test:tier-a-view": "node test/tier-a-view.test.js",
    "test:loadts": "node test/load-typescript.test.js",
    "test:baseref": "node test/base-ref.test.js",
    "test:smoke": "node --test test/loading.test.js test/review-findings-smoke.test.js test/review-preview-smoke.test.js",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactTree",
          "title": "Impact Tree",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "impactTree": [
        {
          "id": "impactTree.sources",
          "name": "Review",
          "contextualTitle": "Impact Tree"
        },
        {
          "id": "impactTree.cards",
          "name": "Cards",
          "contextualTitle": "Impact Tree",
          "when": "config.impactTree.cards.enabled"
        },
        {
          "type": "webview",
          "id": "impactTree.details",
          "name": "Details",
          "contextualTitle": "Impact Tree"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "impactTree.sources",
        "contents": "No folder is open. Open a repository to review its changes and pull requests.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "impactTree.state == noFolder"
      },
      {
        "view": "impactTree.sources",
        "contents": "This folder is not a git repository, so there is nothing to compare.\n[Initialize Repository](command:git.init)\nAlready a repository? [Refresh](command:impactTree.refresh)",
        "when": "impactTree.state == noGit"
      }
    ],
    "commands": [
      {
        "command": "impactTree.retryViewedSync",
        "title": "Impact Tree: Retry Viewed on GitHub",
        "icon": "$(sync)"
      },
      {
        "command": "impactTree.refresh",
        "title": "Impact Tree: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "impactTree.filterAttention",
        "title": "Impact Tree: Show only needs attention",
        "icon": "$(warning)"
      },
      {
        "command": "impactTree.filterAttentionOn",
        "title": "Impact Tree: Show all",
        "icon": "$(error)"
      },
      {
        "command": "impactTree.filterUnreviewed",
        "title": "Impact Tree: Hide reviewed",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "impactTree.filterUnreviewedOn",
        "title": "Impact Tree: Show all",
        "icon": "$(circle-large-filled)"
      },
      {
        "command": "impactTree.filterThreads",
        "title": "Impact Tree: Show only unresolved threads",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "impactTree.filterThreadsOn",
        "title": "Impact Tree: Show all",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "impactTree.nextUnreviewed",
        "title": "Impact Tree: Go to next unreviewed change",
        "icon": "$(arrow-down)"
      },
      {
        "command": "impactTree.previousUnreviewed",
        "title": "Impact Tree: Go to previous unreviewed change",
        "icon": "$(arrow-up)"
      },
      {
        "command": "impactTree.viewAsTree",
        "title": "Impact Tree: View as tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "impactTree.viewAsList",
        "title": "Impact Tree: View as list",
        "icon": "$(list-flat)"
      },
      {
        "command": "impactTree.selectMode",
        "title": "Impact Tree: Choose what to review",
        "icon": "$(git-compare)"
      },
      {
        "command": "impactTree.setCheckpoint",
        "title": "Impact Tree: Set checkpoint now",
        "icon": "$(bookmark)"
      },
      {
        "command": "impactTree.openChange",
        "title": "Open change"
      },
      {
        "command": "impactTree.openCaller",
        "title": "Open caller"
      },
      {
        "command": "impactTree.showCallers",
        "title": "Impact Tree: Show callers",
        "icon": "$(references)"
      },
      {
        "command": "impactTree.showChange",
        "title": "Show change in the Details view"
      },
      {
        "command": "impactTree.commentOnCall",
        "title": "Comment on this call",
        "icon": "$(comment)"
      },
      {
        "command": "impactTree.setReviewed",
        "title": "Mark a change reviewed or not"
      },
      {
        "command": "impactTree.showLegend",
        "title": "Impact Tree: Show legend",
        "icon": "$(question)"
      },
      {
        "command": "impactTree.showLog",
        "title": "Impact Tree: Show log",
        "icon": "$(output)"
      },
      {
        "command": "impactTree.openFile",
        "title": "Open file diff"
      },
      {
        "command": "impactTree.computeTestReach",
        "title": "Impact Tree: Compute test reachability"
      },
      {
        "command": "impactTree.clearReviewed",
        "title": "Impact Tree: Clear review progress",
        "icon": "$(clear-all)"
      },
      {
        "command": "impactTree.analyseMode",
        "title": "Analyse with this mode",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.githubSignIn",
        "title": "Sign in to GitHub",
        "category": "Impact Tree",
        "icon": "$(sign-in)"
      },
      {
        "command": "impactTree.refreshPullRequests",
        "title": "Refresh pull requests",
        "category": "Impact Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "impactTree.openPullRequest",
        "title": "Open pull request",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.review.startReview",
        "title": "Start review"
      },
      {
        "command": "impactTree.review.commentNow",
        "title": "Comment now"
      },
      {
        "command": "impactTree.review.addReviewComment",
        "title": "Add review comment"
      },
      {
        "command": "impactTree.review.reply",
        "title": "Reply"
      },
      {
        "command": "impactTree.review.replyToReview",
        "title": "Add to review"
      },
      {
        "command": "impactTree.review.resolve",
        "title": "Resolve conversation",
        "icon": "$(check)"
      },
      {
        "command": "impactTree.review.unresolve",
        "title": "Unresolve conversation",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "impactTree.review.deletePendingComment",
        "title": "Delete pending comment",
        "icon": "$(trash)"
      },
      {
        "command": "impactTree.review.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "impactTree.review.saveEdit",
        "title": "Save"
      },
      {
        "command": "impactTree.review.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "impactTree.review.removeCallerContext",
        "title": "Remove caller context",
        "icon": "$(close)"
      },
      {
        "command": "impactTree.review.suggestChange",
        "title": "Suggest change",
        "category": "Impact Tree",
        "icon": "$(diff)"
      },
      {
        "command": "impactTree.review.applySuggestion",
        "title": "Apply suggestion",
        "icon": "$(check)"
      },
      {
        "command": "impactTree.showPullRequest",
        "title": "Open pull request tab",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.submitReview",
        "title": "Submit review…",
        "category": "Impact Tree",
        "icon": "$(git-pull-request-go-to-changes)"
      },
      {
        "command": "impactTree.submitReviewUnavailable",
        "title": "Submit review… (loading the pull request review)",
        "category": "Impact Tree",
        "icon": "$(git-pull-request-go-to-changes)",
        "enablement": "false"
      },
      {
        "command": "impactTree.revealReviewThread",
        "title": "Go to review thread",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.add",
        "title": "Add feedback",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.cancel",
        "title": "Cancel",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.edit",
        "title": "Edit feedback draft",
        "category": "Impact Tree",
        "icon": "$(edit)"
      },
      {
        "command": "impactTree.feedback.saveEdit",
        "title": "Save",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.cancelEdit",
        "title": "Cancel",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.delete",
        "title": "Delete feedback draft",
        "category": "Impact Tree",
        "icon": "$(trash)"
      },
      {
        "command": "impactTree.feedback.open",
        "title": "Open feedback draft",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.showDrafts",
        "title": "Show feedback drafts",
        "category": "Impact Tree",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "impactTree.connectAgent",
        "title": "Connect my agent…",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.disconnectAgent",
        "title": "Disconnect my agent…",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.openReview",
        "title": "Open review",
        "category": "Impact Tree",
        "icon": "$(preview)"
      },
      {
        "command": "impactTree.analyseWithAgent",
        "title": "Analyse with my agent",
        "category": "Impact Tree",
        "icon": "$(sparkle)"
      },
      {
        "command": "impactTree.cancelAgentWaiting",
        "title": "Cancel waiting",
        "category": "Impact Tree",
        "icon": "$(close)"
      },
      {
        "command": "impactTree.toggleAgentCards",
        "title": "Show engine cards or agent cards",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.undoAgentResult",
        "title": "Undo the agent's result",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.sendFeedback",
        "title": "Send feedback",
        "category": "Impact Tree",
        "icon": "$(send)"
      },
      {
        "command": "impactTree.sendFeedbackTo",
        "title": "Send feedback to…",
        "category": "Impact Tree",
        "icon": "$(send)"
      },
      {
        "command": "impactTree.cleanUpStoredData",
        "title": "Clean up stored data",
        "category": "Impact Tree",
        "icon": "$(trash)"
      },
      {
        "command": "impactTree.feedback.openRoundItem",
        "title": "Open feedback item",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.feedback.reply",
        "title": "Reply in next round",
        "category": "Impact Tree",
        "icon": "$(reply)"
      },
      {
        "command": "impactTree.feedback.openRoundFile",
        "title": "Open feedback file",
        "category": "Impact Tree",
        "icon": "$(go-to-file)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "impactTree.mcp",
        "label": "Impact Tree"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "impactTree.openReview",
          "when": "view == impactTree.cards && config.impactTree.cards.enabled",
          "group": "navigation@0"
        },
        {
          "command": "impactTree.analyseWithAgent",
          "when": "view == impactTree.cards && config.impactTree.agents.enabled",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.previousUnreviewed",
          "when": "view == impactTree.sources",
          "group": "0_go@1"
        },
        {
          "command": "impactTree.nextUnreviewed",
          "when": "view == impactTree.sources",
          "group": "0_go@2"
        },
        {
          "command": "impactTree.showLog",
          "when": "view == impactTree.sources",
          "group": "2_help@2"
        },
        {
          "command": "impactTree.refreshPullRequests",
          "when": "view == impactTree.sources",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.showLegend",
          "when": "view == impactTree.sources",
          "group": "2_help@1"
        }
      ],
      "commandPalette": [
        {
          "command": "impactTree.analyseWithAgent",
          "when": "config.impactTree.agents.enabled && config.impactTree.cards.enabled"
        },
        {
          "command": "impactTree.cancelAgentWaiting",
          "when": "false"
        },
        {
          "command": "impactTree.toggleAgentCards",
          "when": "false"
        },
        {
          "command": "impactTree.undoAgentResult",
          "when": "false"
        },
        {
          "command": "impactTree.connectAgent",
          "when": "config.impactTree.agents.enabled"
        },
        {
          "command": "impactTree.disconnectAgent",
          "when": "config.impactTree.agents.enabled"
        },
        {
          "command": "impactTree.retryViewedSync",
          "when": "false"
        },
        {
          "command": "impactTree.filterAttention",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.filterAttentionOn",
          "when": "false"
        },
        {
          "command": "impactTree.filterUnreviewed",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.filterUnreviewedOn",
          "when": "false"
        },
        {
          "command": "impactTree.filterThreads",
          "when": "impactTree.hasReviewThreads"
        },
        {
          "command": "impactTree.filterThreadsOn",
          "when": "false"
        },
        {
          "command": "impactTree.nextUnreviewed",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.previousUnreviewed",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.submitReviewUnavailable",
          "when": "false"
        },
        {
          "command": "impactTree.analyseMode",
          "when": "false"
        },
        {
          "command": "impactTree.openPullRequest",
          "when": "false"
        },
        {
          "command": "impactTree.showCallers",
          "when": "impactTree.hasReview"
        },
        {
          "command": "impactTree.showChange",
          "when": "false"
        },
        {
          "command": "impactTree.commentOnCall",
          "when": "false"
        },
        {
          "command": "impactTree.setReviewed",
          "when": "false"
        },
        {
          "command": "impactTree.review.startReview",
          "when": "false"
        },
        {
          "command": "impactTree.review.commentNow",
          "when": "false"
        },
        {
          "command": "impactTree.review.addReviewComment",
          "when": "false"
        },
        {
          "command": "impactTree.review.reply",
          "when": "false"
        },
        {
          "command": "impactTree.review.replyToReview",
          "when": "false"
        },
        {
          "command": "impactTree.review.resolve",
          "when": "false"
        },
        {
          "command": "impactTree.review.unresolve",
          "when": "false"
        },
        {
          "command": "impactTree.review.deletePendingComment",
          "when": "false"
        },
        {
          "command": "impactTree.review.editComment",
          "when": "false"
        },
        {
          "command": "impactTree.review.saveEdit",
          "when": "false"
        },
        {
          "command": "impactTree.review.cancelEdit",
          "when": "false"
        },
        {
          "command": "impactTree.review.removeCallerContext",
          "when": "false"
        },
        {
          "command": "impactTree.review.suggestChange",
          "when": "impactTree.canSuggestChange"
        },
        {
          "command": "impactTree.review.applySuggestion",
          "when": "false"
        },
        {
          "command": "impactTree.showPullRequest",
          "when": "impactTree.hasPullRequestReview"
        },
        {
          "command": "impactTree.submitReview",
          "when": "impactTree.hasPullRequestReview"
        },
        {
          "command": "impactTree.revealReviewThread",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.add",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.cancel",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.edit",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.saveEdit",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.cancelEdit",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.delete",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.open",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.showDrafts",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.sendFeedbackTo",
          "when": "impactTree.hasFeedbackDrafts"
        },
        {
          "command": "impactTree.feedback.openRoundItem",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "false"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "false"
        },
        {
          "command": "impactTree.openReview",
          "when": "config.impactTree.cards.enabled"
        }
      ],
      "editor/context": [
        {
          "command": "impactTree.review.suggestChange",
          "group": "impactTree@1",
          "when": "impactTree.canSuggestChange"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "impactTree.review.startReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.commentNow",
          "group": "inline@2",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.addReviewComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThreadIsEmpty && impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.reply",
          "group": "inline@1",
          "when": "commentController == impactTree.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/ && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.replyToReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && !commentThreadIsEmpty && commentThread =~ /\\bcanReply\\b/ && impactTree.reviewPending"
        },
        {
          "command": "impactTree.feedback.add",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && commentThreadIsEmpty"
        },
        {
          "command": "impactTree.feedback.cancel",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "impactTree.review.resolve",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcanResolve\\b/"
        },
        {
          "command": "impactTree.review.unresolve",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcanUnresolve\\b/"
        },
        {
          "command": "impactTree.review.removeCallerContext",
          "group": "inline@1",
          "when": "commentController == impactTree.review && commentThread =~ /\\bcallerContext\\b/"
        },
        {
          "command": "impactTree.review.suggestChange",
          "group": "inline@2",
          "when": "commentController == impactTree.review && commentThreadIsEmpty"
        }
      ],
      "comments/comment/title": [
        {
          "command": "impactTree.review.editComment",
          "group": "inline@0",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.deletePendingComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment =~ /\\bpendingMine\\b/"
        },
        {
          "command": "impactTree.review.applySuggestion",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment =~ /\\bhasSuggestion\\b/"
        },
        {
          "command": "impactTree.feedback.edit",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        },
        {
          "command": "impactTree.feedback.delete",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        }
      ],
      "view/item/context": [
        {
          "command": "impactTree.refresh",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "inline@4"
        },
        {
          "command": "impactTree.filterAttention",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter != attention",
          "group": "inline@3"
        },
        {
          "command": "impactTree.filterAttentionOn",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter == attention",
          "group": "inline@3"
        },
        {
          "command": "impactTree.filterUnreviewed",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter != unreviewed",
          "group": "0_filter@2"
        },
        {
          "command": "impactTree.filterUnreviewedOn",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter == unreviewed",
          "group": "0_filter@2"
        },
        {
          "command": "impactTree.filterThreads",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter != threads && impactTree.hasReviewThreads",
          "group": "0_filter@3"
        },
        {
          "command": "impactTree.filterThreadsOn",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.filter == threads",
          "group": "0_filter@3"
        },
        {
          "command": "impactTree.previousUnreviewed",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "0_go@1"
        },
        {
          "command": "impactTree.nextUnreviewed",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "0_go@2"
        },
        {
          "command": "impactTree.viewAsTree",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.fileListLayout != tree",
          "group": "inline@2"
        },
        {
          "command": "impactTree.viewAsList",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.fileListLayout == tree",
          "group": "inline@2"
        },
        {
          "command": "impactTree.selectMode",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "1_mode@1"
        },
        {
          "command": "impactTree.setCheckpoint",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "1_mode@2"
        },
        {
          "command": "impactTree.showLog",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "2_help@2"
        },
        {
          "command": "impactTree.clearReviewed",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "3_progress@1"
        },
        {
          "command": "impactTree.submitReview",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.hasPullRequestReview && !impactTree.pullRequestReviewLoading",
          "group": "inline@5"
        },
        {
          "command": "impactTree.submitReviewUnavailable",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.hasPullRequestReview && impactTree.pullRequestReviewLoading",
          "group": "inline@5"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "view == impactTree.sources && viewItem == reviewHost && impactTree.hasFeedbackDrafts",
          "group": "inline@6",
          "alt": "impactTree.sendFeedbackTo"
        },
        {
          "command": "impactTree.showLegend",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "2_help@1"
        },
        {
          "command": "impactTree.cleanUpStoredData",
          "when": "view == impactTree.sources && viewItem == reviewHost",
          "group": "3_progress@2"
        },
        {
          "command": "impactTree.openReview",
          "when": "view == impactTree.sources && viewItem == reviewHost && config.impactTree.cards.enabled",
          "group": "inline@1"
        },
        {
          "command": "impactTree.showCallers",
          "when": "view == impactTree.sources && viewItem == finding",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.commentOnCall",
          "when": "view == impactTree.sources && viewItem =~ /^(caller|changedCaller)$/",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.showCallers",
          "when": "view == impactTree.sources && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "impactTree.retryViewedSync",
          "when": "view == impactTree.sources && viewItem =~ /ViewedFailed$/",
          "group": "inline"
        },
        {
          "command": "impactTree.feedback.edit",
          "when": "view == impactTree.sources && viewItem == feedbackDraft",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.delete",
          "when": "view == impactTree.sources && viewItem == feedbackDraft",
          "group": "inline@2"
        },
        {
          "command": "impactTree.feedback.edit",
          "when": "view == impactTree.sources && viewItem == feedbackDraft",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.feedback.delete",
          "when": "view == impactTree.sources && viewItem == feedbackDraft",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "view == impactTree.sources && viewItem == feedbackGroup",
          "group": "inline@1"
        },
        {
          "command": "impactTree.sendFeedback",
          "when": "view == impactTree.sources && viewItem =~ /^feedback(Group|Draft)$/",
          "group": "send@1"
        },
        {
          "command": "impactTree.sendFeedbackTo",
          "when": "view == impactTree.sources && viewItem =~ /^feedback(Group|Draft)$/",
          "group": "send@2"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "view == impactTree.sources && viewItem == feedbackRoundItem",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.reply",
          "when": "view == impactTree.sources && viewItem == feedbackRoundItem",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "view == impactTree.sources && viewItem == feedbackRound",
          "group": "inline@1"
        },
        {
          "command": "impactTree.feedback.openRoundFile",
          "when": "view == impactTree.sources && viewItem == feedbackRound",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.cancelAgentWaiting",
          "when": "view == impactTree.cards && viewItem == agentWaiting",
          "group": "inline"
        }
      ],
      "comments/comment/context": [
        {
          "command": "impactTree.review.saveEdit",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.cancelEdit",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment =~ /\\bcanEdit\\b/"
        },
        {
          "command": "impactTree.review.startReview",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment == suggestionDraft && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.commentNow",
          "group": "inline@2",
          "when": "commentController == impactTree.review && comment == suggestionDraft && !impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.addReviewComment",
          "group": "inline@1",
          "when": "commentController == impactTree.review && comment == suggestionDraft && impactTree.reviewPending"
        },
        {
          "command": "impactTree.review.cancelEdit",
          "group": "inline@3",
          "when": "commentController == impactTree.review && comment == suggestionDraft"
        },
        {
          "command": "impactTree.feedback.saveEdit",
          "group": "inline@1",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        },
        {
          "command": "impactTree.feedback.cancelEdit",
          "group": "inline@2",
          "when": "commentController == impactTree.feedback && comment == feedbackDraft"
        }
      ]
    },
    "keybindings": [
      {
        "command": "impactTree.nextUnreviewed",
        "key": "alt+n",
        "when": "impactTree.hasReview"
      },
      {
        "command": "impactTree.previousUnreviewed",
        "key": "shift+alt+n",
        "when": "impactTree.hasReview"
      },
      {
        "command": "impactTree.showCallers",
        "key": "shift+alt+c",
        "when": "editorTextFocus && impactTree.hasReview"
      }
    ],
    "configuration": {
      "title": "Impact Tree",
      "properties": {
        "impactTree.openPullRequestTab": {
          "type": "boolean",
          "default": true,
          "description": "Open the Pull Request tab (description, checks, reviewers, labels, merge and review submit) when you preview or check out a pull request from the list."
        },
        "impactTree.githubRemote": {
          "type": "string",
          "default": "",
          "description": "The git remote of the GitHub repository whose pull requests are reviewed. Empty: `upstream` if it points at GitHub, else `origin`, else the only GitHub remote."
        },
        "impactTree.mode": {
          "type": "string",
          "enum": [
            "pr",
            "branch",
            "working",
            "checkpoint"
          ],
          "default": "pr",
          "description": "What to review: pr = Branch vs base (the commits a pull request would hold); branch = Branch + uncommitted; working = Uncommitted (agent), your edits since the last commit; checkpoint = Since checkpoint, everything since the commit you recorded."
        },
        "impactTree.baseBranch": {
          "type": "string",
          "default": "",
          "description": "Base branch. Empty: the remote's default branch (its HEAD, such as main or master). Always resolved to <remote>/<branch>, where the remote is the GitHub remote (impactTree.githubRemote), else origin; an out-of-date local ref silently inflates the diff. Write <remote>/<branch>, for example origin/main, to read it from another remote."
        },
        "impactTree.fetchBase": {
          "type": "boolean",
          "default": true,
          "description": "git fetch the base before resolving it"
        },
        "impactTree.reachDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 6,
          "description": "How many caller levels the test-reachability walk follows upward from a changed symbol, 1 to 6. A test further up than this is not looked for, so \"no test reaches\" means no test within this many levels. A value outside the range is replaced with 2 (or 6 when too large) and a warning is shown."
        },
        "impactTree.analyseOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Analyse as soon as the window opens"
        },
        "impactTree.alwaysDiffCallers": {
          "type": "boolean",
          "default": false,
          "description": "Open every caller as a diff against the base, even when the file is identical to base (which shows two panes of the same content). Default: diff only when the file actually differs."
        },
        "impactTree.concurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "description": "How many symbols to resolve callers for in parallel, from 1 to 32. A value above 32 is capped at 32; a value that is not a number of at least 1 is replaced by the default, 8. Either correction is reported as an analysis warning."
        },
        "impactTree.iconMode": {
          "type": "string",
          "enum": [
            "file",
            "symbol"
          ],
          "default": "symbol",
          "enumDescriptions": [
            "File-type glyph from your icon theme (matches the Explorer and other review extensions)",
            "Symbol-kind icon: method / function / constructor (matches Outline)"
          ],
          "description": "Which icon change rows use. File rows always show the file-type glyph."
        },
        "impactTree.rowDetail": {
          "type": "string",
          "enum": [
            "hover",
            "inline"
          ],
          "default": "hover",
          "enumDescriptions": [
            "A change row shows its verdict glyph only; the verdict in words and the change kinds are in the hover tooltip",
            "A change row also shows the verdict in words and the change kinds (denser, truncates in narrow sidebars)"
          ],
          "description": "Where a change row's verdict and change kinds are shown."
        },
        "impactTree.cards.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Show a Cards view that groups the changes of a review into related cards, with the entry points each card reaches and which cards may belong together. Turning it on adds the entry-point search to each analysis (a few seconds on the largest pull requests) and, for a local review, reads the repository's history for merge hints. Takes effect from the next analysis (Refresh)."
        },
        "impactTree.agents.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Let your own coding agent (connected through Impact Tree's MCP server) learn which review this window shows and hand back results (card titles and summaries, callers it found), which are kept in this workspace. While on, the window listens on a local socket in a private temporary folder, guarded by a token; nothing leaves your machine. Only reviews of a checked-out branch take part; a pull request preview does not."
        },
        "impactTree.fileListLayout": {
          "type": "string",
          "enum": [
            "flat",
            "tree"
          ],
          "default": "flat",
          "enumDescriptions": [
            "One row per changed file, worst first",
            "Changed files in their folders, as in the GitHub Pull Requests extension; folders and files are still ordered worst first at every level, and a folder is ranked by its worst file"
          ],
          "description": "How the Changes view lays out the changed files. Also toggled from the view's title bar (View as tree / View as list)."
        },
        "impactTree.prewarm": {
          "type": "boolean",
          "default": true,
          "description": "After the window opens, quietly ask the language server to index the changed files so the first analysis is fast. The index is built either way; this just pays for it before you ask."
        },
        "impactTree.filterInheritedOverReports": {
          "type": "boolean",
          "default": true,
          "description": "Drop callers the TypeScript call hierarchy attributes to an override but which actually dispatch on a sibling subclass. Turn off to see the unfiltered call-hierarchy result."
        },
        "impactTree.tierA.maxFiles": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "maximum": 3000,
          "description": "Maximum files to fetch for a no-checkout PR preview, 1 to 3000 (the most the GitHub client lists). Each file costs two GitHub API requests (head and base). A value outside the range is replaced with 300 (or 3000 when too large) and a warning is shown."
        },
        "impactTree.agent": {
          "type": "string",
          "enum": [
            "ask",
            "claude",
            "claude-vscode",
            "codex",
            "cursor-chat",
            "chat",
            "clipboard",
            "save"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask each time; the answer is remembered here",
            "Claude Code: run claude with the prompt in a terminal",
            "Claude Code (VS Code extension): fill its panel with the prompt through a link; you press Enter",
            "Codex: run codex with the prompt in a terminal",
            "Cursor (when this editor is Cursor): open the prompt through Cursor's link; you confirm it and send it",
            "Fill the editor's chat (VS Code Copilot Chat, Cursor) with the prompt; you press Enter",
            "Copy the prompt to the clipboard",
            "Only save the feedback file"
          ],
          "description": "Where Send feedback hands a feedback round, and where Analyse with my agent hands its prompt. \"Send feedback to…\" always asks."
        }
      }
    }
  },
