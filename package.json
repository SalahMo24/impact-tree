          "group": "3_progress@1"
        },
        {
          "command": "impactTree.refreshPullRequests",
          "when": "view == impactTree.sources",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.submitReview",
          "when": "view == impactTree.changes && impactTree.hasPullRequestReview && !impactTree.pullRequestReviewLoading",
          "group": "navigation@6"
        },
        {
          "command": "impactTree.submitReviewUnavailable",
          "when": "view == impactTree.changes && impactTree.hasPullRequestReview && impactTree.pullRequestReviewLoading",
          "group": "navigation@6"
        },
