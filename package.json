{
  "name": "impact-tree",
  "publisher": "SalahMo24",
  "displayName": "Impact Tree",
  "icon": "images/icon.png",
  "description": "Review a diff as an inverted call graph — see what each change affects and which callers weren't updated.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "analyze": "node --max-old-space-size=8192 src/cli.js",
    "test": "node test/loading.test.js && node test/caller-retry.test.js && node test/scope.test.js && node test/local-symbols.test.js && node test/local-diff.test.js && node test/local-programs.test.js && node test/syntax-regressions.test.js && node test/remote-regressions.test.js && node test/editor-regressions.test.js && node test/review-identity-regressions.test.js && node test/engine-regressions.test.js && node test/cqrs-cache.test.js && node test/call-site-classifier.test.js && node test/unseen-users.test.js && node test/caller-evidence.test.js && node test/extension-commands.test.js && node test/cancellation.test.js && node test/request-boundary.test.js && node test/session-lifecycle.test.js && node test/review-key.test.js && node test/load-typescript.test.js && node test/github-remote.test.js && node test/base-ref.test.js && node test/extension-remotes.test.js && node test/sources.test.js && node test/pr-groups.test.js && node test/tier-a-view.test.js && node test/tree-grouping.test.js && node test/tree-characterization.test.js && node test/tree-grouping-rules.test.js && node test/tree-row-models.test.js && node test/empty-states-and-limits.test.js && node test/path-tree.test.js && node test/folder-tree.test.js && node test/review-tree-model.test.js && node test/feedback-file.test.js && node test/vocabulary.test.js && node test/review-tree-view.test.js && node test/tree-cleanup.test.js && node test/review-updates.test.js && node test/review-navigation.test.js && node test/detail-panel-html.test.js && node test/detail-panel.test.js && node test/review-lens.test.js && node test/pr-review-data.test.js && node test/pr-review-store.test.js && node test/pr-overview-html.test.js && node test/pr-overview-panel.test.js && node test/diff-lines.test.js && node test/review-comments.test.js && node test/suggestions.test.js && node test/feedback-drafts.test.js && node test/feedback-comments.test.js && node test/feedback-tree.test.js && node test/review-threads.test.js && node test/review-threads-details.test.js && node test/viewed-sync.test.js && node test/outside-functions.test.js && node test/test-reach.test.js && node test/test-reach-view.test.js && node test/syntactic-index.test.js && node test/inheritance.test.js && node test/tier-a.test.js && node test/preview-retention.test.js && node --max-old-space-size=8192 test/languages.test.js && node --max-old-space-size=8192 test/textpos.test.js && node --max-old-space-size=8192 test/callsites.test.js && node --max-old-space-size=8192 test/run-fixtures.js && node --max-old-space-size=8192 test/tree-smoke.js && node test/storage-cleanup.test.js && node test/agent-handoff.test.js && node test/feedback-round-model.test.js && node test/feedback-readback.test.js && node test/feedback-send.test.js && node test/storage-cleanup-run.test.js && node test/feedback-round-view.test.js && node test/snapshot-store.test.js",
    "record": "node --max-old-space-size=8192 test/record-fixture.js",
    "test:snapshots": "node --max-old-space-size=8192 test/t3-pr-snapshots.js",
    "test:fixtures": "node --max-old-space-size=8192 test/run-fixtures.js",
    "test:tree": "node --max-old-space-size=8192 test/tree-smoke.js",
    "test:textpos": "node test/textpos.test.js",
    "test:callsites": "node --max-old-space-size=8192 test/callsites.test.js",
    "test:languages": "node --max-old-space-size=8192 test/languages.test.js",
    "test:scope": "node test/scope.test.js",
    "test:sources": "node test/sources.test.js",
    "test:syntactic": "node test/syntactic-index.test.js",
    "test:inheritance": "node test/inheritance.test.js",
    "test:tier-a": "node test/tier-a.test.js",
    "test:tier-a-view": "node test/tier-a-view.test.js",
    "test:loadts": "node test/load-typescript.test.js",
    "test:baseref": "node test/base-ref.test.js",
    "test:smoke": "node --test test/loading.test.js test/review-findings-smoke.test.js test/review-preview-smoke.test.js",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json"
