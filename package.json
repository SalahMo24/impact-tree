{
  "name": "impact-tree",
  "publisher": "SalahMo24",
  "displayName": "Impact Tree",
  "description": "Review a diff as an inverted call graph \u2014 see what each change affects and which callers weren't updated.",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./src/extension.js",
  "scripts": {
    "analyze": "node --max-old-space-size=8192 src/cli.js",
    "test": "node test/scope.test.js && node test/local-analysis.test.js && node test/bug-regressions.test.js && node test/call-site-classifier.test.js && node test/caller-evidence.test.js && node test/extension-commands.test.js && node test/load-typescript.test.js && node test/base-ref.test.js && node test/sources.test.js && node test/tier-a-view.test.js && node test/tree-grouping.test.js && node test/syntactic-index.test.js && node test/inheritance.test.js && node test/tier-a.test.js && node --max-old-space-size=8192 test/languages.test.js && node --max-old-space-size=8192 test/textpos.test.js && node --max-old-space-size=8192 test/callsites.test.js && node --max-old-space-size=8192 test/run-fixtures.js && node --max-old-space-size=8192 test/tree-smoke.js",
    "record": "node --max-old-space-size=8192 test/record-fixture.js",
    "test:fixtures": "node --max-old-space-size=8192 test/run-fixtures.js",
    "test:tree": "node --max-old-space-size=8192 test/tree-smoke.js",
    "test:textpos": "node test/textpos.test.js",
    "test:callsites": "node --max-old-space-size=8192 test/callsites.test.js",
    "test:languages": "node --max-old-space-size=8192 test/languages.test.js",
    "test:scope": "node test/scope.test.js",
    "test:sources": "node test/sources.test.js",
    "test:syntactic": "node test/syntactic-index.test.js",
    "test:inheritance": "node test/inheritance.test.js",
    "test:tier-a": "node test/tier-a.test.js",
    "test:tier-a-view": "node test/tier-a-view.test.js",
    "test:loadts": "node test/load-typescript.test.js",
    "test:baseref": "node test/base-ref.test.js",
    "lint": "eslint src",
    "typecheck": "tsc -p jsconfig.json"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "impactTree",
          "title": "Impact Tree",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "impactTree": [
        {
          "id": "impactTree.sources",
          "name": "Review",
          "contextualTitle": "Impact Tree"
        },
        {
          "id": "impactTree.changes",
          "name": "Changes by blast radius",
          "contextualTitle": "Impact Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "impactTree.refresh",
        "title": "Impact Tree: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "impactTree.selectMode",
        "title": "Impact Tree: Select diff mode",
        "icon": "$(git-compare)"
      },
      {
        "command": "impactTree.setCheckpoint",
        "title": "Impact Tree: Set review checkpoint here",
        "icon": "$(bookmark)"
      },
      {
        "command": "impactTree.openChange",
        "title": "Open change"
      },
      {
        "command": "impactTree.openCaller",
        "title": "Open caller"
      },
      {
        "command": "impactTree.showLegend",
        "title": "Impact Tree: Show legend",
        "icon": "$(question)"
      },
      {
        "command": "impactTree.showLog",
        "title": "Impact Tree: Show log",
        "icon": "$(output)"
      },
      {
        "command": "impactTree.openFile",
        "title": "Open file diff"
      },
      {
        "command": "impactTree.computeTestReach",
        "title": "Impact Tree: Compute test reachability"
      },
      {
        "command": "impactTree.clearReviewed",
        "title": "Impact Tree: Clear review progress",
        "icon": "$(clear-all)"
      },
      {
        "command": "impactTree.analyseMode",
        "title": "Analyse with this mode",
        "category": "Impact Tree"
      },
      {
        "command": "impactTree.githubSignIn",
        "title": "Sign in to GitHub",
        "category": "Impact Tree",
        "icon": "$(sign-in)"
      },
      {
        "command": "impactTree.refreshPullRequests",
        "title": "Refresh pull requests",
        "category": "Impact Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "impactTree.openPullRequest",
        "title": "Open pull request",
        "category": "Impact Tree"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "impactTree.refresh",
          "when": "view == impactTree.changes",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.selectMode",
          "when": "view == impactTree.changes",
          "group": "navigation@2"
        },
        {
          "command": "impactTree.setCheckpoint",
          "when": "view == impactTree.changes",
          "group": "navigation@3"
        },
        {
          "command": "impactTree.showLegend",
          "when": "view == impactTree.changes",
          "group": "navigation@4"
        },
        {
          "command": "impactTree.showLog",
          "when": "view == impactTree.changes",
          "group": "navigation@5"
        },
        {
          "command": "impactTree.clearReviewed",
          "when": "view == impactTree.changes",
          "group": "navigation@6"
        },
        {
          "command": "impactTree.refreshPullRequests",
          "when": "view == impactTree.sources",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "impactTree.analyseMode",
          "when": "false"
        },
        {
          "command": "impactTree.openPullRequest",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Impact Tree",
      "properties": {
        "impactTree.mode": {
          "type": "string",
          "enum": [
            "pr",
            "branch",
            "working",
            "checkpoint"
          ],
          "default": "pr",
          "description": "pr = committed branch vs base; branch = includes uncommitted; working = uncommitted only (agent review); checkpoint = since a recorded SHA"
        },
        "impactTree.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Base branch. Always resolved to origin/<branch>; a stale local ref silently inflates the diff."
        },
        "impactTree.fetchBase": {
          "type": "boolean",
          "default": true,
          "description": "git fetch the base before resolving it"
        },
        "impactTree.reachDepth": {
          "type": "number",
          "default": 2,
          "description": "Upward closure depth for test reachability"
        },
        "impactTree.analyseOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Analyse as soon as the window opens"
        },
        "impactTree.alwaysDiffCallers": {
          "type": "boolean",
          "default": false,
          "description": "Open every caller as a diff against the base, even when the file is identical to base (which shows two panes of the same content). Default: diff only when the file actually differs."
        },
        "impactTree.concurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "description": "How many symbols to resolve callers for in parallel, from 1 to 32. A value above 32 is capped at 32; a value that is not a number of at least 1 is replaced by the default, 8. Either correction is reported as an analysis warning."
        },
        "impactTree.iconMode": {
          "type": "string",
          "enum": [
            "file",
            "symbol"
          ],
          "default": "file",
          "enumDescriptions": [
            "File-type glyph from your icon theme (matches the Explorer and other review extensions)",
            "Symbol-kind icon: method / function / constructor (matches Outline)"
          ],
          "description": "Which icon code rows use."
        },
        "impactTree.rowDetail": {
          "type": "string",
          "enum": [
            "hover",
            "inline"
          ],
          "default": "hover",
          "enumDescriptions": [
            "Rows show icon + name + git badge only; all detail in the hover tooltip",
            "Rows also show state, kinds and file inline (denser, truncates in narrow sidebars)"
          ],
          "description": "Where row detail is shown."
        },
        "impactTree.fileListLayout": {
          "type": "string",
          "enum": [
            "tree",
            "flat"
          ],
          "default": "tree",
          "enumDescriptions": [
            "Nest files under collapsible folders, with single-child chains compacted",
            "One row per file, directory shown in the description"
          ],
          "description": "How the file list is grouped (mirrors githubPullRequests.fileListLayout)."
        },
        "impactTree.prewarm": {
          "type": "boolean",
          "default": true,
          "description": "After the window opens, quietly ask the language server to index the changed files so the first analysis is fast. The index is built either way; this just pays for it before you ask."
        },
        "impactTree.filterInheritedOverReports": {
          "type": "boolean",
          "default": true,
          "description": "Drop callers the TypeScript call hierarchy attributes to an override but which actually dispatch on a sibling subclass. Turn off to see the unfiltered call-hierarchy result."
        },
        "impactTree.tierA.maxFiles": {
          "type": "number",
          "default": 300,
          "description": "Maximum files to fetch for a no-checkout PR preview. Each file costs two GitHub API requests (head and base)."
        }
      }
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SalahMo24/impact-tree.git"
  },
  "bugs": {
    "url": "https://github.com/SalahMo24/impact-tree/issues"
  },
  "keywords": [
    "pull request",
    "code review",
    "pr review",
    "diff",
    "call hierarchy",
    "call graph",
    "impact analysis",
    "blast radius",
    "dependency graph",
    "refactoring",
    "typescript",
    "github"
  ],
  "dependencies": {
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
