          "group": "navigation@5"
        },
        {
          "command": "impactTree.selectMode",
          "when": "view == impactTree.changes",
          "group": "1_mode@1"
        },
        {
          "command": "impactTree.setCheckpoint",
          "when": "view == impactTree.changes",
          "group": "1_mode@2"
        },
        {
          "command": "impactTree.showLog",
          "when": "view == impactTree.changes",
          "group": "2_help@2"
        },
        {
          "command": "impactTree.clearReviewed",
          "when": "view == impactTree.changes",
          "group": "3_progress@1"
        },
        {
          "command": "impactTree.refreshPullRequests",
          "when": "view == impactTree.sources",
          "group": "navigation@1"
        },
        {
          "command": "impactTree.submitReview",
          "when": "view == impactTree.changes && impactTree.hasPullRequestReview && !impactTree.pullRequestReviewLoading",
