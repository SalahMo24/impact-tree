          "command": "impactTree.showLegend",
          "when": "view == impactTree.changes",
          "group": "navigation@9"
        },
        {
          "command": "impactTree.cleanUpStoredData",
          "when": "view == impactTree.changes",
          "group": "3_progress@2"
        }
